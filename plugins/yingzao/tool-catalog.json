          },
          "stage": {
            "enum": [
              "reference",
              "shape",
              "topology",
              "uv",
              "materials",
              "rig",
              "animation",
              "vfx",
              "qa",
              "export"
            ]
          },
          "collection": {
            "type": "string"
          },
          "texture_resolution": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "plan": {
            "type": "object"
          },
          "requirement": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "context_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "enum": [
              "completed",
              "no_results",
              "unavailable"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
