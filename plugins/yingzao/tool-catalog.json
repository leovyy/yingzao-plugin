{
  "schema": 1,
  "tools": [
    {
      "name": "plugin_settings_read",
      "description": "读取映造原生插件设置与本机 API 管理入口；不读取密钥、不联网。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "_meta": {
        "ui": {
          "visibility": [
            "app"
          ]
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object"
          },
          "schema": {
            "type": "object"
          },
          "layout": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "values",
          "schema"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "plugin_settings_update",
      "description": "保存启用、内部 API 权限、自动分析与丫鸭设置，不接收密钥。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "set": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "title": "启用映造",
                "description": "启用工作流与桌面入口；关闭不取消已接受任务。"
              },
              "use_internal_api": {
                "type": "boolean",
                "title": "使用映造内部 API",
                "description": "独立控制内部模型调用权限；关闭仍可查库，不自动切换收费服务。"
              },
              "desktop_visible": {
                "type": "boolean",
                "title": "显示桌面丫鸭",
                "description": "隐藏时保留位置；启用映造后生效。"
              },
              "desktop_size": {
                "type": "integer",
                "title": "丫鸭大小（px）",
                "minimum": 96,
                "maximum": 320
              },
              "desktop_opacity": {
                "type": "integer",
                "title": "丫鸭不透明度（%）",
                "minimum": 30,
                "maximum": 100
              },
              "desktop_topmost": {
                "type": "boolean",
                "title": "保持置顶"
              },
              "desktop_locked": {
                "type": "boolean",
                "title": "锁定丫鸭位置"
              },
              "desktop_feed_enabled": {
                "type": "boolean",
                "title": "允许拖入喂图"
              },
              "desktop_auto_analyze": {
                "type": "boolean",
                "title": "喂图后自动分析",
                "description": "默认由 Codex Agent 看图提炼；结果只写入本地库，不推定喜欢。"
              },
              "desktop_analysis_backend": {
                "type": "string",
                "title": "自动分析执行方式",
                "enum": [
                  "codex_agent",
                  "internal_api"
                ],
                "enumNames": [
                  "Codex Agent（默认）",
                  "映造内部 API"
                ],
                "description": "默认使用当前 Codex；明确选择内部 API 或宿主确实没有所需能力时，才使用已允许的内部服务。"
              },
              "desktop_open_after_feed": {
                "type": "boolean",
                "title": "喂图后打开审美库"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "required": [
          "set"
        ],
        "additionalProperties": false
      },
      "_meta": {
        "ui": {
          "visibility": [
            "app"
          ]
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object"
          }
        },
        "required": [
          "values"
        ]
      }
    },
    {
      "name": "plugin_use_internal_api",
      "description": "使用映造内部 API；未配置自动打开本机 API 配置，不发送模型请求。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "title": "使用映造内部 API"
    },
    {
      "name": "plugin_open",
      "description": "打开审美库与集中管理，含图片偏好、记忆、安全API配置、本地资料与更新；宿主支持时内嵌显示，否则独立本机页面。记忆不在工作台展示；不调用模型。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "title": "API、记忆、审美与丫鸭设置",
      "_meta": {
        "ui": {
          "resourceUri": "ui://yingzao/plugin.html"
        },
        "openai/ui": {
          "entrypoints": [
            {
              "type": "global"
            },
            {
              "type": "thread"
            }
          ]
        }
      }
    },
    {
      "name": "plugin_aesthetics",
      "description": "插件审美库：包体只读库与插件本地案例联合检索、原图、分析和明确反馈；list/detail/recall不调用模型，recover仅恢复安装旁遗留媒体为偏好未知、未分析。不得把无元数据恢复说成原偏好恢复；不上传云库。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "list",
              "detail",
              "recall",
              "recover",
              "prepare_extraction",
              "commit_extraction",
              "feedback",
              "like",
              "dislike",
              "delete",
              "feature_choice",
              "all_features"
            ]
          },
          "project_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "status": {
            "enum": [
              "all",
              "analyzed",
              "not_analyzed"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "ident": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "source_id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "analysis": {
            "type": "object"
          },
          "inspection_sha256": {
            "type": "string"
          },
          "option_id": {
            "type": "string"
          },
          "choice": {
            "enum": [
              "liked",
              "disliked",
              null
            ]
          },
          "expected_choice": {
            "enum": [
              "liked",
              "disliked",
              null
            ]
          },
          "include_images": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plugin_desktop",
      "description": "丫鸭本地桌面设置，实时调整显示、大小、透明度、位置锁定与喂图；不调用模型。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "read",
              "update",
              "reset_position"
            ]
          },
          "values": {
            "type": "object"
          },
          "expected_revision": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plugin_storage",
      "description": "查看插件本地资料位置，或打开已登记的资料目录；无云库上传。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "enum": [
              "root",
              "memory",
              "aesthetics",
              "projects"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plugin_update",
      "description": "检查、安装或回退经过校验的映造插件运行时；保留本地资料，不终止在途任务。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "check",
              "install",
              "rollback",
              "status"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plugin_memory",
      "description": "插件工作记忆：仅检索插件本地记忆库及真实工作回执；distill按原文提炼候选并保留来源，确认后再remember；原回执只读。明确记忆须有消息来源，修改/忘记须带版本，防重复与跨项目串写；不调用模型。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "list",
              "recall",
              "remember",
              "update",
              "forget",
              "history",
              "export",
              "distill"
            ]
          },
          "project_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "ident": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "source_message_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "preference",
              "project",
              "procedure"
            ]
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plugin_workflow",
      "description": "默认制作准备与按阶段指导：prepare检索本地审美；guide读取版本化模型/特效方法；audit_script生成待宿主执行的归属场景只读审计代码，生成不代表检查通过。search记录宿主联网来源；不调用模型。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "prepare",
              "search",
              "get",
              "design",
              "guide",
              "audit_script"
